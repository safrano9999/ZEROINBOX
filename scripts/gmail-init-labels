#!/usr/bin/env python3
"""Interactive Gmail label setup from ZEROINBOX config.json.

Default behavior creates labels over Gmail IMAP, using the app password already
needed by ZEROINBOX. No Google Cloud OAuth JSON is required for the default
path.

Optional: set ZEROINBOX_LABEL_METHOD=gmail-api to create labels via the Gmail
API. That path needs .gmail-oauth-client.json from Google Cloud.
"""
from __future__ import annotations

import getpass
import imaplib
import json
import os
import re
import sys
from pathlib import Path
from typing import Any


SCOPES = ["https://www.googleapis.com/auth/gmail.labels"]
GMAIL_DOMAINS = ("@gmail.com", "@googlemail.com")

ROOT_DIR = Path(__file__).resolve().parent.parent
CONFIG_PATH = ROOT_DIR / "config.json"
ENV_PATH = ROOT_DIR / ".env"
OAUTH_CLIENT_PATH = ROOT_DIR / ".gmail-oauth-client.json"
LEGACY_TOKEN_PATH = ROOT_DIR / ".gmail-token.json"


def is_gmail(email: str) -> bool:
    return email.lower().endswith(GMAIL_DOMAINS)


def quote_mailbox(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def token_path_for(email: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.@-]+", "_", email.strip().lower())
    return ROOT_DIR / f".gmail-token-{safe}.json"


def ask(question: str) -> str:
    return input(f"{question}: ").strip()


def ask_choice(question: str, options: tuple[str, ...]) -> str:
    pretty = "/".join(options)
    while True:
        value = ask(f"{question} ({pretty})").lower()
        if value in options:
            return value


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def upsert_env(path: Path, updates: dict[str, str]) -> None:
    lines: list[str] = []
    seen: set[str] = set()
    if path.exists():
        for raw in path.read_text(encoding="utf-8").splitlines():
            stripped = raw.strip()
            if not stripped or stripped.startswith("#") or "=" not in stripped:
                lines.append(raw)
                continue
            key = stripped.split("=", 1)[0].strip()
            if key in updates:
                lines.append(f"{key}={updates[key]}")
                seen.add(key)
            else:
                lines.append(raw)
    for key, value in updates.items():
        if key not in seen:
            lines.append(f"{key}={value}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    path.chmod(0o600)


def load_config() -> dict[str, Any]:
    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def default_account(config: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    name = config.get("defaultAccount")
    account = config.get("accounts", {}).get(name)
    if not account:
        raise SystemExit(f"defaultAccount '{name}' not found in {CONFIG_PATH}.")
    return str(name), account


def env_key(account: dict[str, Any], field: str, fallback: str) -> str:
    value = account.get(field)
    return str(value or fallback)


def flow_complete() -> tuple[str, str, dict[str, Any], list[dict[str, Any]], bool]:
    config = load_config()
    name, account = default_account(config)
    env = read_env(ENV_PATH)
    user_env = env_key(account, "usernameEnv", "ZEROINBOX_GMAIL_USERNAME")
    pass_env = env_key(account, "passwordEnv", "ZEROINBOX_GMAIL_APP_PASSWORD")
    email = env.get(user_env, "").strip()
    password = env.get(pass_env, "").strip().replace(" ", "")
    if not email:
        raise SystemExit(f"{user_env} is empty in {ENV_PATH}. Run 'new' first or fill it in.")
    if not password:
        raise SystemExit(f"{pass_env} is empty in {ENV_PATH}. Run 'new' first or fill it in.")
    if not is_gmail(email):
        raise SystemExit(f"'{email}' is not @gmail.com / @googlemail.com — aborting.")
    print(f"Using {email} from config account '{name}'.")
    return email, password, account, account.get("destinations") or [], False


def flow_new() -> tuple[str, str, dict[str, Any], list[dict[str, Any]], bool]:
    email = ask("New Gmail address")
    if not is_gmail(email):
        raise SystemExit(f"'{email}' is not @gmail.com / @googlemail.com — aborting.")
    password = getpass.getpass("Gmail App Password (16 chars, no spaces required): ").strip().replace(" ", "")
    if not password:
        raise SystemExit("App password required — aborting.")
    config = load_config()
    name, account = default_account(config)
    user_env = env_key(account, "usernameEnv", "ZEROINBOX_GMAIL_USERNAME")
    pass_env = env_key(account, "passwordEnv", "ZEROINBOX_GMAIL_APP_PASSWORD")
    upsert_env(ENV_PATH, {user_env: email, pass_env: password})
    print(f"Wrote {user_env} and {pass_env} to {ENV_PATH}.")
    print(f"Using config account '{name}'.")
    return email, password, account, account.get("destinations") or [], True


def create_label_imap(conn: imaplib.IMAP4_SSL, name: str) -> tuple[str, str]:
    status, data = conn.create(quote_mailbox(name))
    detail = " ".join(
        item.decode("utf-8", errors="replace") if isinstance(item, bytes) else str(item)
        for item in data or []
    )
    if status == "OK":
        return "created", detail
    lowered = detail.lower()
    if "exist" in lowered or "already" in lowered:
        return "exists", detail
    return "error", detail or status


def create_labels_imap(email: str, password: str, account: dict[str, Any], targets: list[tuple[str, str]]) -> int:
    host = str(account.get("host") or "imap.gmail.com")
    port = int(account.get("port") or 993)
    print(f"\nCreating labels over IMAP at {host}:{port} as {email}:")
    failed = 0
    conn = imaplib.IMAP4_SSL(host, port)
    try:
        conn.login(email, password)
        for key, label in targets:
            status, detail = create_label_imap(conn, label)
            if status == "created":
                print(f"  [created ] {key:<16} -> {label}")
            elif status == "exists":
                print(f"  [exists  ] {key:<16} -> {label}")
            else:
                failed += 1
                print(f"  [error   ] {key:<16} -> {label}  ({detail})")
    finally:
        try:
            conn.logout()
        except Exception:
            pass
    return failed


def load_gmail_api_modules():
    try:
        from google.auth.transport.requests import Request
        from google.oauth2.credentials import Credentials
        from google_auth_oauthlib.flow import InstalledAppFlow
        from googleapiclient.discovery import build
        from googleapiclient.errors import HttpError
    except ImportError as exc:
        raise SystemExit(
            f"Missing dependency: {exc}\n"
            "Install:\n"
            "  scripts/setup-python.sh"
        )
    return Request, Credentials, InstalledAppFlow, build, HttpError


def get_gmail_api_service(email: str, reset_token: bool):
    Request, Credentials, InstalledAppFlow, build, _ = load_gmail_api_modules()
    token_path = token_path_for(email)
    if reset_token and token_path.exists():
        token_path.unlink()
    if reset_token and LEGACY_TOKEN_PATH.exists():
        LEGACY_TOKEN_PATH.unlink()
    creds = None
    if token_path.exists():
        creds = Credentials.from_authorized_user_file(str(token_path), SCOPES)
    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            if not OAUTH_CLIENT_PATH.exists():
                raise SystemExit(
                    f"OAuth client JSON missing at {OAUTH_CLIENT_PATH}.\n"
                    "Only needed for ZEROINBOX_LABEL_METHOD=gmail-api.\n"
                    "Default IMAP label setup does not need this file."
                )
            flow = InstalledAppFlow.from_client_secrets_file(str(OAUTH_CLIENT_PATH), SCOPES)
            creds = flow.run_local_server(port=0)
        token_path.write_text(creds.to_json(), encoding="utf-8")
        token_path.chmod(0o600)
    return build("gmail", "v1", credentials=creds, cache_discovery=False)


def create_labels_gmail_api(email: str, reset_token: bool, targets: list[tuple[str, str]]) -> int:
    _, _, _, _, HttpError = load_gmail_api_modules()
    print(f"\nAuthenticating to Gmail API as {email}…")
    if reset_token:
        print("(new account selected — OAuth consent required)")
    service = get_gmail_api_service(email, reset_token)
    result = service.users().labels().list(userId="me").execute()
    existing = {label["name"] for label in result.get("labels", [])}
    print("\nCreating labels via Gmail API:")
    failed = 0
    for key, label in targets:
        if label in existing:
            print(f"  [exists  ] {key:<16} -> {label}")
            continue
        body = {
            "name": label,
            "labelListVisibility": "labelShow",
            "messageListVisibility": "show",
        }
        try:
            created = service.users().labels().create(userId="me", body=body).execute()
            existing.add(label)
            print(f"  [created ] {key:<16} -> {label} ({created.get('id', '')})")
        except HttpError as exc:
            status = getattr(exc.resp, "status", 0)
            if status == 409:
                print(f"  [exists  ] {key:<16} -> {label}")
            else:
                failed += 1
                print(f"  [error   ] {key:<16} -> {label}  (HTTP {status}: {exc})")
    return failed


def target_labels(destinations: list[dict[str, Any]]) -> list[tuple[str, str]]:
    targets: list[tuple[str, str]] = []
    for entry in destinations:
        key = str(entry.get("key") or "").strip()
        label = str(entry.get("mailbox") or "").strip()
        if key and label:
            targets.append((key, label))
    return targets


def main() -> int:
    print("ZEROINBOX Gmail label setup")
    mode = ask_choice("Mode", ("new", "complete"))
    email, password, account, destinations, reset_token = flow_new() if mode == "new" else flow_complete()
    targets = target_labels(destinations)
    if not targets:
        print("No destinations in config — nothing to create.")
        return 0

    method = os.environ.get("ZEROINBOX_LABEL_METHOD", "imap").strip().lower()
    if method in {"imap", "gmail-imap"}:
        failed = create_labels_imap(email, password, account, targets)
    elif method in {"gmail-api", "api", "oauth"}:
        failed = create_labels_gmail_api(email, reset_token, targets)
    else:
        raise SystemExit("ZEROINBOX_LABEL_METHOD must be 'imap' or 'gmail-api'.")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        sys.stderr.write("\naborted\n")
        sys.exit(130)
