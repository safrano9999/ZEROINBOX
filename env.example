# env.example - secrets and runtime credentials for ZEROINBOX.
# Account/provider structure lives in config.conf; provider.conf only defines
# built-in provider defaults.

# Account 1 credentials. The matching provider is ZEROINBOX_PROVIDER in config.conf.
ZEROINBOX_EMAIL=
ZEROINBOX_APP_PASSWORD=

# Account 2 credentials. Uncomment when ZEROINBOX_PROVIDER_2 is enabled.
# ZEROINBOX_EMAIL_2=
# ZEROINBOX_APP_PASSWORD_2=

# Account 3 credentials. Useful for a dynamic provider such as "ms".
# ZEROINBOX_EMAIL_3=
# ZEROINBOX_APP_PASSWORD_3=

# LiteLLM proxy used by ZEROINBOX itself for classification.
LITELLM_URL=
LITELLM_PORT=
LITELLM_API_KEY=
ZEROINBOX_MODEL=gemini/gemini-flash-lite-latest
