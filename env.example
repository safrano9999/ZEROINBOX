# env.example - hardcoded source of truth for ZEROINBOX (OpenClaw plugin / standalone CLI).
# Copy to .env for standalone use.

# Gmail IMAP - use an app password, not the account password
ZEROINBOX_GMAIL_USERNAME=
ZEROINBOX_GMAIL_APP_PASSWORD=

# LiteLLM proxy used by ZEROINBOX itself for classification
LITELLM_URL=
LITELLM_PORT=
LITELLM_API_KEY=
ZEROINBOX_MODEL=gemini/gemini-flash-lite-latest
