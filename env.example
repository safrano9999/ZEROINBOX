# env.example - runtime credentials for ZEROINBOX.
# Account provider/user/password values are written by ZEROINBOX_init.sh.

# First account. Additional accounts use ZEROINBOX_PROVIDER_2,
# ZEROINBOX_EMAIL_2, ZEROINBOX_APP_PASSWORD_2, and so on.
#required: required
ZEROINBOX_PROVIDER=gmail
#required: required
ZEROINBOX_EMAIL=
#required: required
ZEROINBOX_APP_PASSWORD=

# Custom provider example when ZEROINBOX_PROVIDER=ms.
# ZEROINBOX_PROVIDER_MS_URL=outlook.office365.com
# ZEROINBOX_PROVIDER_MS_PORT=993
# ZEROINBOX_PROVIDER_MS_INBOX=INBOX
# ZEROINBOX_PROVIDER_MS_SEARCH=UNSEEN
# ZEROINBOX_PROVIDER_MS_ARCHIVE_PREFIX=ZEROINBOX/Archiv

# OpenAI-compatible v1 endpoint used by ZEROINBOX itself for classification.
#required: required
ZEROINBOX_OPENAI_V1_DEFAULT_LLM=gemini/gemini-flash-lite-latest
OPENAI_V1_PROVIDER=
#required: required
OPENAI_V1_URL=
#required: required
OPENAI_V1_PORT=
#required: required
OPENAI_V1_KEY=
