#repeat-group: ZEROINBOX suffix ZEROINBOX_PROVIDER ZEROINBOX_EMAIL ZEROINBOX_APP_PASSWORD ZEROINBOX_ONLY_UNSEEN
#required: required
ZEROINBOX_PROVIDER=gmail
#required: required
ZEROINBOX_EMAIL=
#required: required
#secret
ZEROINBOX_APP_PASSWORD=
#default-preset: 1
ZEROINBOX_ONLY_UNSEEN=1

#named-volume: /named_volumes/ZEROINBOX /named_volumes/ZEROINBOX/REPORTS @ZEROINBOX_DIR@/REPORTS dir
#default-preset: 1
ZEROINBOX_REPORTS_VOLUME=1

#named-volume: /named_volumes/ZEROINBOX /named_volumes/ZEROINBOX/logs @ZEROINBOX_DIR@/logs dir
#default-preset: 1
ZEROINBOX_LOGS_VOLUME=1

#named-volume: /named_volumes/ZEROINBOX /named_volumes/ZEROINBOX/maildir @ZEROINBOX_DIR@/maildir dir
#default-preset: 1
ZEROINBOX_MAILDIR_VOLUME=1

#required: required
#default-preset: luna
ZEROINBOX_OPENAI_V1_DEFAULT_LLM=luna
#repeat-group: OPENAI_V1 suffix OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_API_KEY_ALIAS OPENAI_V1_STREAM
#required: required
OPENAI_V1_PROVIDER=
#required: required
OPENAI_V1_URL=
#default-preset: 443
#required: required
OPENAI_V1_PORT=443
#required: required
#secret
OPENAI_V1_KEY=
#reverse-varname: OPENAI_V1_KEY
#required: required
OPENAI_V1_API_KEY_ALIAS=

#default-preset: true
OPENAI_V1_STREAM=true
